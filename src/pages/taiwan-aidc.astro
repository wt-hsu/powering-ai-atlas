---
import Base from '../layouts/Base.astro';
import TaiwanAidcMap from '../components/TaiwanAidcMap.jsx';
import TaiwanTimeline from '../components/TaiwanTimeline.jsx';
import data from '../data/taiwan-aidc.json';

const repo = 'https://github.com/wt-hsu/powering-ai-atlas';
---

<Base
  title="台灣 AIDC 開發案地圖 — Powering AI Atlas"
  description="台灣 AI 資料中心開發案互動地圖:需求最密的北部正是供電最緊的北部,成長的出口在南部算力廊帶。Taiwan's AI data centers, mapped against its grid constraints."
>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=IBM+Plex+Mono:wght@400;600&display=swap"
    rel="stylesheet"
  />

  <main>
    <article>
      <header class="piece-header container">
        <p class="kicker">Powering AI Atlas · No. 2</p>
        <h1>台灣 AIDC 開發案地圖</h1>
        <p class="standfirst">
          需求最密的北部,正是供電最緊的北部;成長的出口在南部算力廊帶。
          Taiwan's AI data center boom, mapped against the grid that constrains it.
        </p>
        <p class="byline">
          By Wanting Hsu · 資料查核日 {data.auditDate} ·
          <a href={`${repo}/blob/main/DATA_AUDIT.md`} target="_blank" rel="noopener">逐案來源 DATA_AUDIT</a>
        </p>
      </header>

      <TaiwanAidcMap client:only="react" />

      <section class="stats container">
        <div class="stat">
          <div class="stat-num">{data.stats.inZone.mw}<span class="stat-unit">MW</span></div>
          <div class="stat-label">{data.stats.inZone.n} 案擠在北北基桃「暫緩供電區」內</div>
        </div>
        <div class="stat">
          <div class="stat-num">{data.grid.central_to_north.peak_flow_mw.toLocaleString()}<span class="stat-unit">MW</span></div>
          <div class="stat-label">中電北送預估尖峰潮流({data.grid.central_to_north.year},立法院引台電)</div>
        </div>
        <div class="stat">
          <div class="stat-num">{data.grid.north_twh_2023.demand} <span class="stat-vs">vs</span> {data.grid.north_twh_2023.supply}</div>
          <div class="stat-label">北部用電 vs 發電(億度,2023,台電)——缺口靠中南部北送</div>
        </div>
      </section>

      <section class="container timeline-sec">
        <h2 class="sec-title">每年新增案場 New sites per year</h2>
        <TaiwanTimeline client:only="react" />
      </section>

      <section class="notes container">
        <h2>不入圖・側記 Off-map</h2>
        <ul>
          {data.sidecard.map((line) => <li>{line}</li>)}
        </ul>

        <h2>讀圖前提 Method &amp; caveats</h2>
        <p>
          圓面積 ≈ 各案公開揭露容量,口徑依個案不同(契約容量/最大負載/IT 負載),圖上不做容量加總。
          座標為鄉鎮級示意,只承諾行政區、不承諾街廓。狀態語意:實心=營運中、空心=建置/規劃中、灰空心=規模未揭露。
          高雄 NVIDIA×鴻海為嵌套畫法:內實圈=已商轉容量、外空圈=首期建置上限。
        </p>
        <p>
          資料為公開報導與官方新聞稿彙整,逐案來源、可信度評級與待核清單見
          <a href={`${repo}/blob/main/DATA_AUDIT.md`} target="_blank" rel="noopener">DATA_AUDIT.md</a>;
          製作規格見 <a href={`${repo}/blob/main/SPEC.md`} target="_blank" rel="noopener">SPEC.md</a>。
          靜態海報版(SVG/PNG,深淺兩色)在
          <a href={`${repo}/tree/main/output`} target="_blank" rel="noopener">output/</a>。
          縣市界:內政部,經 <a href="https://www.npmjs.com/package/taiwan-atlas" target="_blank" rel="noopener">taiwan-atlas</a>。
          Basemap © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>
          contributors, © <a href="https://carto.com/attributions" target="_blank" rel="noopener">CARTO</a>.
        </p>
      </section>
    </article>
  </main>
</Base>

<style>
  .piece-header {
    padding: 4rem 1.25rem 2.5rem;
    max-width: 46rem;
  }

  .kicker {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.78rem;
    color: var(--glow);
    margin: 0 0 0.75rem;
  }

  .piece-header h1 {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    margin: 0 0 1rem;
  }

  .standfirst {
    font-size: 1.2rem;
    color: var(--ink-2);
  }

  .byline {
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
    margin-top: 1.25rem;
  }

  .stat {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.9rem 1.1rem;
  }

  .stat-num {
    font-family: 'IBM Plex Mono', var(--font-sans);
    font-variant-numeric: tabular-nums;
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--ink);
  }

  .stat-unit {
    font-size: 0.9rem;
    color: var(--ink-muted);
    margin-left: 0.15rem;
  }

  .stat-vs {
    font-size: 0.85rem;
    color: var(--ink-muted);
  }

  .stat-label {
    font-size: 0.78rem;
    color: var(--ink-muted);
    margin-top: 0.3rem;
    line-height: 1.45;
  }

  .timeline-sec {
    margin-top: 2.5rem;
  }

  .sec-title {
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    margin: 0 0 0.75rem;
  }

  .notes {
    max-width: 46rem;
    margin-top: 3.5rem;
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  .notes h2 {
    font-size: 1.1rem;
  }

  .notes ul {
    padding-left: 1.2rem;
  }
</style>
